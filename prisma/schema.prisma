generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum BusinessRole {
  OWNER
  ADMIN
  STAFF
  CUSTOMER
}

enum BusinessStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  firstName    String
  lastName     String
  status       UserStatus   @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  memberships  Membership[]
}

model Business {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  status      BusinessStatus @default(ACTIVE)
  timeZone    String         @default("Africa/Nairobi")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  memberships Membership[]
  services    Service[]
  staff       StaffMember[]
}

model Membership {
  id         String       @id @default(cuid())
  userId     String
  businessId String
  role       BusinessRole @default(CUSTOMER)
  createdAt  DateTime     @default(now())
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([businessId, role])
  @@index([userId])
}

model Service {
  id               String         @id @default(cuid())
  businessId       String
  name             String
  description      String?
  durationMinutes  Int
  price            Decimal        @db.Decimal(10, 2)
  currency         String         @default("KES") @db.Char(3)
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  business         Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staffAssignments StaffService[]

  @@unique([id, businessId])
  @@unique([businessId, name])
  @@index([businessId, isActive])
}

model StaffMember {
  id                 String          @id @default(cuid())
  businessId         String
  displayName        String
  email              String?
  phone              String?
  isActive           Boolean         @default(true)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  business           Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  serviceAssignments StaffService[]
  schedules          StaffSchedule[]

  @@unique([id, businessId])
  @@unique([businessId, email])
  @@index([businessId, isActive])
}

model StaffSchedule {
  id          String      @id @default(cuid())
  businessId  String
  staffId     String
  weekday     Int
  startMinute Int
  endMinute   Int
  createdAt   DateTime    @default(now())
  staff       StaffMember @relation(fields: [staffId, businessId], references: [id, businessId], onDelete: Cascade)

  @@unique([businessId, staffId, weekday, startMinute])
  @@index([businessId, staffId, weekday])
}

model StaffService {
  businessId String
  staffId    String
  serviceId  String
  createdAt  DateTime    @default(now())
  staff      StaffMember @relation(fields: [staffId, businessId], references: [id, businessId], onDelete: Cascade)
  service    Service     @relation(fields: [serviceId, businessId], references: [id, businessId], onDelete: Cascade)

  @@id([businessId, staffId, serviceId])
  @@index([businessId, serviceId])
}
